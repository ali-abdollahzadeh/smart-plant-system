    {
        "id": "func_split_gauge",
        "type": "function",
        "z": "plant_monitor_v2",
        "name": "distribution",
        "func": "if (msg.payload.feeds && msg.payload.feeds.length > 0) {\n    var f = msg.payload.feeds[0];\n    var t = parseFloat(f.field1);\n    var s = parseFloat(f.field2);\n    var h = parseFloat(f.field3);\n    // Standard thresholds (from gauge segments: temp 18-30, soil/humi 30-80)\n    var alert = (isNaN(t) || t < 18 || t > 30 || isNaN(s) || s < 30 || s > 80 || isNaN(h) || h < 30 || h > 80);\n    return [\n        { payload: t },\n        { payload: s },\n        { payload: h },\n        { payload: alert, topic: \"monitor1\" }\n    ];\n}\nreturn null;",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 220,
        "wires": [
            [
                "gauge_temp"
            ],
            [
                "gauge_soil"
            ],
            [
                "gauge_humi"
            ],
            [
                "alert_collector"
            ]
        ]
    },
    {
        "id": "func_format_history",
        "type": "function",
        "z": "plant_monitor_v2",
        "name": "distribution",
        "func": "if (msg.payload.feeds) {\n    let t = [], s = [], h = [];\n    msg.payload.feeds.forEach(f => {\n        let time = new Date(f.created_at).getTime();\n        if(f.field1) t.push({x: time, y: parseFloat(f.field1)});\n        if(f.field2) s.push({x: time, y: parseFloat(f.field2)});\n        if(f.field3) h.push({x: time, y: parseFloat(f.field3)});\n    });\n    \n    // 构造 Chart 节点接受的数组格式\n    return [\n        { payload: [{ \"series\": [\"Temperature\"], \"data\": [t], \"labels\": [\"Temperature\"] }] },\n        { payload: [{ \"series\": [\"Soil Moisture\"], \"data\": [s], \"labels\": [\"Soil Moisture\"] }] },\n        { payload: [{ \"series\": [\"Humidity\"], \"data\": [h], \"labels\": [\"Humidity\"] }] }\n    ];\n}\nreturn null;",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 780,
        "wires": [
            [
                "chart_all_temp"
            ],
            [
                "chart_all_soil"
            ],
            [
                "chart_all_humi"
            ]
        ]
    },
