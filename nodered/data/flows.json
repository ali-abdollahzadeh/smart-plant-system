    {
        "id": "alert_collector",
        "type": "function",
        "z": "plant_monitor_v2",
        "name": "collect alerts",
        "func": "var alerts = flow.get(\"monitor_alerts\") || {};\nif (msg.topic) {\n    alerts[msg.topic] = !!msg.payload;\n    flow.set(\"monitor_alerts\", alerts);\n}\nvar anyAlert = Object.keys(alerts).some(function(k){ return alerts[k]; });\nvar last = flow.get(\"last_any_alert\");\nif (anyAlert !== last) {\n    flow.set(\"last_any_alert\", anyAlert);\n    return { payload: anyAlert };\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 950,
        "y": 420,
        "wires": [
            [
                "ui_alert_style"
            ]
        ]
    },
    {
        "id": "ui_alert_style",
        "type": "ui_template",
        "z": "plant_monitor_v2",
        "group": "ui_group_gauge",
        "name": "Sidebar Alert CSS",
        "order": 99,
        "width": "0",
        "height": "0",
        "format": "<style>\n/* Alert mode: red sidebar and toolbar */\nbody.nr-dashboard-theme md-sidenav.alert-active {\n    background-color: #ffcccc !important;\n}\nbody.nr-dashboard-theme md-sidenav.alert-active md-list-item {\n    color: #a00 !important;\n}\nbody.nr-dashboard-theme md-toolbar.alert-active,\nmd-toolbar#toolbar.alert-active {\n    background-color: #ca3838 !important;\n}\n/* Make sure icons etc visible */\nbody.nr-dashboard-theme md-sidenav.alert-active .md-button {\n    color: #a00 !important;\n}\n</style>\n<script>\n(function(scope) {\n    scope.$watch('msg.payload', function(v) {\n        if (typeof v === 'undefined') return;\n        var sidenav = document.querySelector('md-sidenav');\n        var toolbar = document.querySelector('md-toolbar') || document.querySelector('#toolbar');\n        if (v) {\n            // alert on\n            if (sidenav) {\n                sidenav.classList.add('alert-active');\n                sidenav.style.backgroundColor = '#ffcccc';\n            }\n            if (toolbar) {\n                toolbar.classList.add('alert-active');\n                toolbar.style.backgroundColor = '#ca3838';\n            }\n        } else {\n            // normal\n            if (sidenav) {\n                sidenav.classList.remove('alert-active');\n                sidenav.style.backgroundColor = '';\n            }\n            if (toolbar) {\n                toolbar.classList.remove('alert-active');\n                toolbar.style.backgroundColor = '';\n            }\n        }\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1150,
        "y": 420,
        "wires": [
            []
        ]
    },
